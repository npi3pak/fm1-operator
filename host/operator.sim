# a chord on the default preset, then every page
frames 70
key 7 down
key 11 down
key 14 down
frames 40
screen build/host/out/page_main.ppm
knob SELECT 2
knob ALGO 30
frames 10
screen build/host/out/page_algo.ppm
btn EDIT down
frames 1
btn EDIT up
knob SELECT 1
knob K1 2
knob K2 10
frames 10
screen build/host/out/page_osc.ppm
btn ENV down
frames 1
btn ENV up
knob K3 -10
frames 10
screen build/host/out/page_env.ppm
key 7 up
key 11 up
key 14 up
frames 60
btn GLO down
frames 1
btn GLO up
frames 10
screen build/host/out/page_global.ppm
btn SAVE down
frames 1
btn SAVE up
frames 10
screen build/host/out/page_save.ppm
btn HOME down
frames 1
btn HOME up
midi 0x90 60 120
frames 30
midi 0xE0 0 96
frames 20
midi 0x80 60 0
frames 60
wav build/host/out/operator.wav
